# 이 파일을 `.env` 로 복사하고 실제 키를 채운 뒤  python tools/check_keys.py  로 확인하세요.
# `.env` 는 .gitignore 에 있어 커밋되지 않습니다. 실제 키는 GitHub Secrets 에만 둡니다.

# ── 네이버 검색 API ──────────────────────────────────────────────────────
# https://developers.naver.com/apps → 애플리케이션 등록 → '검색' API 추가 (무료)
# ⚠️ 이 두 개가 없으면 월요일 자동 발행이 통째로 실패합니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 기업마당 ─────────────────────────────────────────────────────────────
# https://www.bizinfo.go.kr/apiDetail.do?id=bizinfoApi 하단 "API 사용 신청" → 이메일로 수신
BIZINFO_KEY=

# ── 공공데이터포털 (K-Startup · 나라장터 공용) ───────────────────────────
# https://www.data.go.kr 로그인 후 아래 두 서비스에 각각 '활용신청'
#   K-Startup 사업공고  https://www.data.go.kr/data/15125364/openapi.do
#   나라장터 입찰공고    https://www.data.go.kr/data/15129394/openapi.do
# ⚠️ 마이페이지의 '일반 인증키(Decoding)' 를 넣으세요.
#    Encoding 키(%2B %3D 같은 문자가 섞인 것)를 넣으면 이중 인코딩되어
#    SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 납니다.
# ⚠️ 활용신청 승인 직후에는 최대 1시간 반영이 걸립니다.
DATA_GO_KR_KEY=
